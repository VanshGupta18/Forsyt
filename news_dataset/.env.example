# Newsemble Environment Variables
# Copy this file to .env and fill in the values.

# PostgreSQL connection string (required)
# Get this from Supabase: Project Settings > Database > Connection String (URI)
# Use the "Transaction" pooler connection on port 6543 for best performance.
# Example: postgresql://postgres.xxxx:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Scrape interval in seconds (default: 86400 = once per day)
# Set to 0 to disable background scraping in the web service
SCRAPE_INTERVAL=86400

# Flask settings
FLASK_ENV=production

# API key required on all /api/* requests (checked against the X-API-Key
# request header). Leave empty to disable auth (local dev only — never
# deploy publicly with this unset).
API_KEY=

# Origin allowed to call the API via CORS, e.g. https://your-frontend.example.
# Leave empty/unset to default to "*" (fine for local dev, not for a public
# deployment).
FRONTEND_ORIGIN=
