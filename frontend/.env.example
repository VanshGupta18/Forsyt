# Dev: leave empty — Vite proxies /api and /health to http://127.0.0.1:5001
# Prod: set to your deployed API origin (no trailing slash), e.g. https://api.example.com
VITE_API_BASE=

# Must match the backend's API_KEY (news_dataset/.env). Leave empty if the
# backend has no API_KEY set (auth disabled).
VITE_API_KEY=
